# Copy to .env and fill in real values for local dev.
# In production, set these in your host's env settings (Vercel / Lovable) —
# never commit real secrets. .env is gitignored.

# --- Public (safe to expose; baked into the client bundle at build time) ---
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# --- Server-only secrets (NEVER expose to the client / commit) ---
# Supabase secret key (bypasses RLS). Used for admin signup in src/lib/auth.functions.ts.
SUPABASE_SECRET_KEY="sb_secret_xxx"
# Gemini API key for daily quiz generation in src/lib/quiz.functions.ts.
GEMINI_API_KEY="your-gemini-api-key"
